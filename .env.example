# ==============================================================================
# Kyber Cloud Gaming - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and customize before deploying:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Always change the AUTH_PASSWORD before exposing ports to a LAN or the internet!
# ==============================================================================

# User & Group IDs (matches the host user for volume permissions)
PUID=1000
PGID=1000

# Virtual Display Configuration
# Supported standard resolutions: 1920x1080, 2560x1440, 3840x2160 (or custom viewport)
RESOLUTION=1920x1080
# Supported refresh rates: 60, 120, 144
REFRESH_RATE=60

# Default Startup Launcher
# Options: menu (Console OS Hub), steam, steam-bigpicture, heroic, browser, desktop
LAUNCHER=menu

# Security & Access Control
# Secures the Kyber streaming controller and Kyber Control Plane REST API
AUTH_USER=gamer
AUTH_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD

# NVIDIA GPU Acceleration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=all

# Production Reverse Proxy (Caddy with automatic HTTPS & HTTP/3)
# Set your fully qualified domain name (FQDN) for public domain deployments:
DOMAIN=gaming.example.com
