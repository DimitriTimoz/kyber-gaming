<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <resistance>
    <strength>10</strength>
    <screen_edge_strength>20</screen_edge_strength>
  </resistance>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <focusLast>yes</focusLast>
    <underMouse>no</underMouse>
    <focusDelay>100</focusDelay>
    <raiseOnFocus>yes</raiseOnFocus>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
    <monitor>Primary</monitor>
    <primaryMonitor>1</primaryMonitor>
  </placement>
  <theme>
    <name>KyberDark</name>
    <titleLayout>NLIMC</titleLayout>
    <keepBorder>yes</keepBorder>
    <animateIconify>no</animateIconify>
    <font place="ActiveWindow">
      <name>sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>sans</name>
      <size>10</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
  </theme>
  <desktops>
    <number>1</number>
    <firstdesk>1</firstdesk>
    <names>
      <name>Gaming</name>
    </names>
  </desktops>

  <keyboard>
    <!-- Window Switching -->
    <keybind key="A-Tab">
      <action name="NextWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow">
        <finalactions>
          <action name="Focus"/>
          <action name="Raise"/>
          <action name="Unshade"/>
        </finalactions>
      </action>
    </keybind>

    <!-- Window Closing & Management (Standard Universal Shortcuts) -->
    <keybind key="A-F4">
      <action name="Close"/>
    </keybind>
    <keybind key="W-q">
      <action name="Close"/>
    </keybind>
    <keybind key="W-c">
      <action name="Close"/>
    </keybind>

    <!-- Force Kill Stalled / Unresponsive Window -->
    <keybind key="W-Escape">
      <action name="Kill"/>
    </keybind>
    <keybind key="A-Escape">
      <action name="Execute">
        <command>xkill</command>
      </action>
    </keybind>

    <!-- Quick Return to Console Hub -->
    <keybind key="F1">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </keybind>
    <keybind key="W-space">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </keybind>
    <keybind key="W-Home">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </keybind>

    <!-- Toggle Window Decorations and Fullscreen on the Fly -->
    <keybind key="A-F11">
      <action name="ToggleDecorations"/>
    </keybind>
    <keybind key="F11">
      <action name="ToggleFullscreen"/>
    </keybind>

    <!-- Window Window State Shortcuts -->
    <keybind key="A-space">
      <action name="ShowMenu"><menu>client-menu</menu></action>
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize"/>
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify"/>
    </keybind>
    <keybind key="W-d">
      <action name="ToggleShowDesktop"/>
    </keybind>

    <!-- Kyber Launchers & Console OS Navigation -->
    <keybind key="W-space">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </keybind>
    <keybind key="W-Home">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </keybind>
    <keybind key="W-t">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute">
        <command>pcmanfm</command>
      </action>
    </keybind>
  </keyboard>

  <mouse>
    <!-- Titlebar Close Button -->
    <context name="Close">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Close"/>
      </mousebind>
    </context>

    <!-- Titlebar Maximize Button -->
    <context name="Maximize">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize"/>
      </mousebind>
    </context>

    <!-- Titlebar Minimize / Iconify Button -->
    <context name="Iconify">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="Unshade"/>
      </mousebind>
      <mousebind button="Left" action="Click">
        <action name="Iconify"/>
      </mousebind>
    </context>

    <!-- Window Titlebar Drag & Double-Click -->
    <context name="Titlebar">
      <mousebind button="Left" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize"/>
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus"/>
        <action name="Raise"/>
        <action name="ShowMenu"><menu>client-menu</menu></action>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Lower"/>
      </mousebind>
    </context>

    <!-- Window Frame Resize and Move (Alt modifier only to allow clicks to pass to client) -->
    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Client Area Context (Alt modifier only to pass raw clicks directly to games/launchers) -->
    <context name="Client">
      <mousebind button="A-Left" action="Drag">
        <action name="Move"/>
      </mousebind>
      <mousebind button="A-Right" action="Drag">
        <action name="Resize"/>
      </mousebind>
    </context>

    <!-- Root Desktop Right-Click Menu -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu"><menu>root-menu</menu></action>
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu"><menu>client-list-combined-menu</menu></action>
      </mousebind>
    </context>
  </mouse>

  <applications>
    <!-- Default for normal desktop applications: Decorated with titlebar, close button, and border -->
    <application class="*">
      <decor>yes</decor>
      <maximized>yes</maximized>
    </application>

    <!-- Dialogs and utility popups: Decorated and centered, not maximized -->
    <application type="dialog">
      <decor>yes</decor>
      <maximized>no</maximized>
      <fullscreen>no</fullscreen>
    </application>

    <!-- Heroic Games Launcher & Eglantine Emulator: Always maximized with titlebar and close button -->
    <application class="*heroic*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <application class="*eglantine*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>
    <application class="*retroarch*">
      <decor>no</decor>
      <fullscreen>yes</fullscreen>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>

    <!-- Steam windows: Do not force-maximize hidden helper or login dialogs -->
    <application class="*steam*">
      <decor>yes</decor>
      <maximized>no</maximized>
    </application>
    <application class="*steamwebhelper*">
      <decor>yes</decor>
      <maximized>no</maximized>
    </application>

    <!-- Main Steam Client Window: Always decorated with titlebar and maximized -->
    <application class="*steam*" title="*Steam*">
      <decor>yes</decor>
      <maximized>yes</maximized>
      <focus>yes</focus>
    </application>

    <!-- Steam Big Picture Mode -->
    <application class="*steamwebhelper*" title="*Big Picture*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <fullscreen>yes</fullscreen>
    </application>

    <!-- Kyber Console OS Hub Kiosk (evaluated last so it always wins) -->
    <application title="*Kyber Console OS*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <fullscreen>yes</fullscreen>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
    <application class="*KyberHub*">
      <decor>no</decor>
      <maximized>yes</maximized>
      <fullscreen>yes</fullscreen>
      <position force="yes">
        <x>0</x>
        <y>0</y>
      </position>
    </application>
  </applications>
</openbox_config>
