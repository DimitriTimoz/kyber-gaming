#!/usr/bin/env bash

# Disable screen blanking and power saving
xset s off
xset s noblank
xset -dpms

# Consistent cursor size for every application (prevents oversized cursors on 4K)
export XCURSOR_SIZE=24
echo "Xcursor.size: 24" | xrdb -merge 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true
mkdir -p "$HOME/.config/gtk-3.0"
printf '[Settings]\ngtk-cursor-theme-size=24\ngtk-application-prefer-dark-theme=1\n' > "$HOME/.config/gtk-3.0/settings.ini"

# Dark background
xsetroot -solid "#101216"

# Apply initial resolution and refresh rate
RES="${RESOLUTION:-1920x1080}"
RATE="${REFRESH_RATE:-60}"
xrandr --output HDMI-0 --mode "$RES" -r "$RATE" 2>/dev/null || xrandr --output DFP-0 --mode "$RES" -r "$RATE" 2>/dev/null || xrandr --output default --mode "$RES" -r "$RATE" 2>/dev/null || xrandr -s "$RES" 2>/dev/null || true

echo "[openbox] Graphical environment initialized."
