<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Kyber Gaming">
    <item label="Console OS Hub">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </item>
    <separator label="Launchers" />
    <item label="Steam">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh steam</command>
      </action>
    </item>
    <item label="Steam Big Picture">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh steam-bigpicture</command>
      </action>
    </item>
    <item label="Heroic Games Launcher">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh heroic</command>
      </action>
    </item>
    <item label="Eglantine (Switch / NX2)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh eglantine</command>
      </action>
    </item>
    <item label="RetroArch (Multi-System Emulator)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh retroarch</command>
      </action>
    </item>
    <item label="Web Browser (Google Chrome)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh browser</command>
      </action>
    </item>
    <separator label="Desktop Tools" />
    <item label="File Manager (Explorateur)">
      <action name="Execute">
        <command>pcmanfm</command>
      </action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </item>
    <item label="Desktop Mode (Panel + Icons)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh desktop</command>
      </action>
    </item>
    <separator label="Window Management" />
    <item label="Close Focused Window (Alt+F4)">
      <action name="Close" />
    </item>
    <item label="Toggle Window Titlebar (Alt+F11)">
      <action name="ToggleDecorations" />
    </item>
    <item label="Force Kill Window (xkill)">
      <action name="Execute">
        <command>xkill</command>
      </action>
    </item>
    <separator />
    <item label="Reconfigure Window Manager">
      <action name="Reconfigure" />
    </item>
    <item label="Restart Steam">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh restart-steam</command>
      </action>
    </item>
  </menu>
</openbox_menu>
