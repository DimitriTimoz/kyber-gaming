<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Kyber Gaming">
    <item label="Console OS Hub">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh menu</command>
      </action>
    </item>
    <separator />
    <item label="Steam">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh steam</command>
      </action>
    </item>
    <item label="Steam Big Picture">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh steam-bigpicture</command>
      </action>
    </item>
    <item label="Heroic Games Launcher">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh heroic</command>
      </action>
    </item>
    <item label="Eglantine (Switch / NX2)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh eglantine</command>
      </action>
    </item>
    <item label="Web Browser (Google Chrome)">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh browser</command>
      </action>
    </item>
    <separator />
    <item label="Reload Steam">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh restart-steam</command>
      </action>
    </item>
    <item label="Show Desktop">
      <action name="Execute">
        <command>/usr/local/bin/switch_launcher.sh desktop</command>
      </action>
    </item>
    <item label="Terminal">
      <action name="Execute">
        <command>x-terminal-emulator</command>
      </action>
    </item>
    <separator />
    <item label="Reconfigure Openbox">
      <action name="Reconfigure" />
    </item>
  </menu>
</openbox_menu>
